<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 联网：拉 GitHub 的东西、上传下载文件 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      通知（Android 13+ 要运行时申请，MainActivity 首开问一次）：
      CI 后台轮询的红绿提醒（WorkManager 每 15 分钟一拍，不引入前台服务）。
      本仓纪律：manifest 里永远不许出现 <service> —— 旧 Agora「前台服务 5 秒超时」
      崩了 140 次的病，靠这条纪律拦死；真要加服务必须连「首行 promote + 看门狗」
      模板一起进，不许只加权限不加模板。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      android:name=.HualuoApplication（0.6.0）：设置/会话库/界面状态挂进程，
      Activity 重建（切出再回来、转屏）只是重新接上同一个状态——「切出就断生成」的病根。

      windowSoftInputMode=adjustResize（2026-09-22 随系统栏让位一起补）：键盘让位
      （RootScreen 的 imePadding）要靠它把窗口让给键盘；缺了它键盘会盖住输入区。
    -->
    <application
        android:name=".HualuoApplication"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">
        <!-- allowBackup=false：备份走我们自己的导出功能（明文、可核对），不依赖系统的 adb backup -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
